# Copy this file to `.env` and fill in real values.
# Local SQLite is used automatically when DATABASE_URL is empty or unset.

# --- LLM (Groq) ---
# Required for real AI diagnosis. When missing, the app falls back to a
# deterministic rule-based diagnosis and clearly reports that AI is unavailable.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_TIMEOUT=45

# --- Database ---
# Local: leave empty -> SQLite at backend/data/aiops.db
# Production (Railway): postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# --- CORS / Frontend ---
# Comma-separated list of extra origins (e.g. your Vercel app).
# localhost origins are always allowed. When empty, all origins are allowed (demo).
CORS_ORIGINS=
